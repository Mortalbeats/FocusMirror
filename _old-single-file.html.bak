  <!-- DASHBOARD -->
  <section class="section" id="section-dashboard">
    <div class="section-header anim-up">
      <div class="section-badge">🎯 Live Tracking</div>
      <h1>Your Focus <span class="gradient-text">Dashboard</span></h1>
      <p>Real-time AI posture & blink tracking + all productivity methods in one place.</p>
    </div>
    <div class="xp-display anim-up-d1">
      <div class="xp-level" id="level-badge">1</div>
      <div class="xp-info">
        <div class="xp-label">⭐ Level <span id="level-label">1</span> · <span id="xp-label">0</span> XP</div>
        <div class="xp-bar-bg"><div class="xp-bar-fill" id="xp-bar-fill" style="width:0%"></div></div>
        <div class="xp-numbers"><span id="xp-current">0</span><span id="xp-next">100</span></div>
      </div>
    </div>
    <div class="dash-grid anim-up-d2">
      <div class="dash-card"><div class="icon">🧠</div><div class="label">Focus Score</div><div class="value" id="dash-score" style="color:var(--primary)">--</div><div class="sub">out of 100</div></div>
      <div class="dash-card"><div class="icon">🪑</div><div class="label">Posture</div><div class="value" id="dash-posture" style="color:var(--secondary)">--</div><div class="sub">score</div></div>
      <div class="dash-card"><div class="icon">👁</div><div class="label">Blinks</div><div class="value" id="dash-blink" style="color:var(--gold)">--</div><div class="sub">total</div><div style="font-size:10px;color:var(--text-dim);margin-top:2px">Rate: <span id="blink-rate">0</span>/min</div></div>
      <div class="dash-card"><div class="icon">⏱</div><div class="label">Session</div><div class="value" id="dash-session" style="color:var(--text-dim)">--</div><div class="sub">minutes</div></div>
    </div>
    <div class="cam-section anim-up-d3">
      <div>
        <div class="cam-wrap"><video id="video" autoplay muted playsinline></video><canvas id="overlay"></canvas><div class="cam-badge">LIVE</div></div>
        <div class="cam-status" id="cam-status">Initializing camera...</div>
        <div class="blink-tune">
          <button class="btn btn-secondary btn-sm" onclick="recalibrateBlink()">↺ Recalibrate eyes</button>
        </div>
      </div>
      <div>
        <div class="name-box"><label>Your Name</label><input class="name-input" id="name-input" type="text" placeholder="Enter your name..." maxlength="20"></div>
        <div class="cam-controls" style="display:flex;gap:8px;margin-bottom:10px">
          <button class="btn btn-primary" id="start-btn" disabled onclick="startTracking()" style="flex:1">▶ Start</button>
          <button class="btn btn-secondary" onclick="resetSession()" style="flex:1">↺ Reset</button>
        </div>
        <div class="bars-box">
          <div class="bars-title">Live Biometrics</div>
          <div class="bar-row"><span class="bar-name">Focus Score</span><span class="bar-num" id="b-score">0</span></div>
          <div class="bar-track"><div class="bar-fill" id="bf-score" style="width:0%;background:var(--primary)"></div></div>
          <div class="bar-row"><span class="bar-name">Posture</span><span class="bar-num" id="b-posture">0</span></div>
          <div class="bar-track"><div class="bar-fill" id="bf-posture" style="width:0%;background:var(--secondary)"></div></div>
          <div class="bar-row"><span class="bar-name">Blink Health</span><span class="bar-num" id="b-blink">0</span></div>
          <div class="bar-track"><div class="bar-fill" id="bf-blink" style="width:0%;background:var(--gold)"></div></div>
        </div>
        <div class="alert-box" id="alert-box"><div class="alert-state" id="state-label">READY</div><div class="alert-msg" id="rec-text">Enter your name and press Start</div></div>
      </div>
    </div>
    <div class="chart-box anim-up-d4">
      <div class="bars-title">Focus Trend</div>
      <canvas id="focusChart" height="80"></canvas>
    </div>
  </section>

  <!-- TECHNIQUES INDEX -->
  <section class="section" id="section-techniques">
    <div class="section-header anim-up">
      <div class="section-badge">🎯 All Methods</div>
      <h1>Focus <span class="gradient-text">Techniques</span></h1>
      <p>Choose a method below. Each opens its dedicated timer with instructions.</p>
    </div>
    <div class="tech-grid anim-up-d1">
      <div class="tech-card" onclick="openTechnique('pomodoro')">
        <div class="tech-card-header"><div class="tech-icon">🍅</div><div><div class="tech-title">Pomodoro</div><div style="font-size:10px;color:var(--text-dim)">25 min sprints · 5 min breaks</div></div></div>
        <div class="tech-desc">Work in focused 25-minute intervals with short breaks. The gold standard of time management.</div>
        <div class="tech-meta"><span class="tech-tag">⏱ 25 min</span><span class="tech-tag gold">⭐ +50 XP</span><span class="tech-tag green" id="pom-stats-tech">0 sessions</span></div>
      </div>
      <div class="tech-card" onclick="openTechnique('timeblock')">
        <div class="tech-card-header"><div class="tech-icon">📋</div><div><div class="tech-title">Time Blocking</div><div style="font-size:10px;color:var(--text-dim)">Custom blocks · Task-focused</div></div></div>
        <div class="tech-desc">Divide your day into dedicated blocks. One task per block, move on only when time's up.</div>
        <div class="tech-meta"><span class="tech-tag">⏱ 15-120 min</span><span class="tech-tag gold">⭐ +40 XP</span><span class="tech-tag green" id="tb-stats-tech">0 blocks</span></div>
      </div>
      <div class="tech-card" onclick="openTechnique('mindfulness')">
        <div class="tech-card-header"><div class="tech-icon">🧘</div><div><div class="tech-title">Mindfulness</div><div style="font-size:10px;color:var(--text-dim)">Box breathing · Mental reset</div></div></div>
        <div class="tech-desc">Guided 4-4-4-4 breathing meditation. Reset your focus in just 5 minutes.</div>
        <div class="tech-meta"><span class="tech-tag">⏱ 5 min</span><span class="tech-tag gold">⭐ +30 XP</span><span class="tech-tag green" id="mind-stats-tech">0 sessions</span></div>
      </div>
      <div class="tech-card" onclick="openTechnique('taskdump')">
        <div class="tech-card-header"><div class="tech-icon">📝</div><div><div class="tech-title">Brain Sweep</div><div style="font-size:10px;color:var(--text-dim)">Dump distractions · Clear mind</div></div></div>
        <div class="tech-desc">Clear mental clutter by dumping every distracting thought onto a notepad.</div>
        <div class="tech-meta"><span class="tech-tag">⏱ Anytime</span><span class="tech-tag gold">⭐ +10 XP</span><span class="tech-tag green" id="dump-stats-tech">0 thoughts</span></div>
      </div>
    </div>

        <!-- TECHNIQUE TIMER VIEWS (shown one at a time) -->
    <div id="technique-views" style="display:none">
      <button class="btn btn-secondary btn-sm" onclick="closeTechnique()" style="margin-bottom:14px">← Back to Techniques</button>
      
      <!-- POMODORO VIEW -->
      <div class="technique-view" id="view-pomodoro" style="display:none">
        <div class="timers-grid">
          <div class="timer-card" id="pom-card">
            <div class="timer-card-header"><div class="timer-card-icon">🍅</div><div><div class="timer-card-title">Pomodoro Technique</div><div class="timer-card-sub" id="pom-phase">Focus Session</div></div></div>
            <div class="timer-display"><div class="time" id="pom-display">25:00</div><div class="phase" id="pom-label">25 min work · 5 min break</div></div>
            <div class="timer-controls"><button class="btn btn-primary" id="pom-start-btn" onclick="togglePomodoro()">▶ Start</button><button class="btn btn-secondary" onclick="resetPomodoro()">↺ Reset</button></div>
            <div class="stats-row"><span class="mini-stat" id="pom-sessions">Sessions: 0</span><span class="mini-stat" id="pom-today">Today: 0 min</span></div>
            <div style="margin-top:14px;padding:14px;background:rgba(0,206,201,0.06);border-radius:10px;font-size:12px;color:var(--text-muted);line-height:1.8">
              <b style="color:var(--secondary)">How to use:</b><br>
              1. Set timer for <b>25 minutes</b><br>
              2. Work on a <b>single task</b> with no interruptions<br>
              3. When timer rings — take a <b>5-minute break</b><br>
              4. After 4 cycles, take a <b>15-30 min break</b>
            </div>
          </div>
        </div>
      </div>
      
      <!-- TIME BLOCKING VIEW -->
      <div class="technique-view" id="view-timeblock" style="display:none">
        <div class="timers-grid">
          <div class="timer-card" id="tb-card">
            <div class="timer-card-header"><div class="timer-card-icon">📋</div><div><div class="timer-card-title">Time Blocking</div><div class="timer-card-sub" id="tb-phase">Ready</div></div></div>
            <div style="display:flex;gap:8px;margin-bottom:10px">
              <input class="name-input" id="tb-task" placeholder="What will you work on?" style="flex:1;font-size:13px">
              <select class="name-input" id="tb-duration" style="width:auto;font-size:12px"><option value="15">15m</option><option value="30" selected>30m</option><option value="45">45m</option><option value="60">1h</option><option value="90">1.5h</option><option value="120">2h</option></select>
            </div>
            <div class="timer-display"><div class="time" id="tb-display" style="font-size:42px">00:30:00</div><div class="phase" id="tb-label">Assign one task to this block</div></div>
            <div class="timer-controls"><button class="btn btn-primary" id="tb-start-btn" onclick="toggleTimeBlock()">▶ Start Block</button><button class="btn btn-secondary" onclick="resetTimeBlock()">↺ Reset</button></div>
            <div class="stats-row"><span class="mini-stat" id="tb-task-label">Task: —</span><span class="mini-stat" id="tb-blocks-today">Blocks: 0</span></div>
            <div style="margin-top:14px;padding:14px;background:rgba(0,206,201,0.06);border-radius:10px;font-size:12px;color:var(--text-muted);line-height:1.8">
              <b style="color:var(--secondary)">How to use:</b><br>
              1. Divide your day into <b>specific blocks</b> of time<br>
              2. Assign <b>one single task</b> to each block<br>
              3. Work only on that task during the block<br>
              4. Move to next task <b>only when block ends</b>
            </div>
          </div>
        </div>
      </div>
      
      <!-- MINDFULNESS VIEW -->
      <div class="technique-view" id="view-mindfulness" style="display:none">
        <div class="timers-grid">
          <div class="timer-card" id="mind-card" style="text-align:center">
            <div class="timer-card-header" style="justify-content:center"><div class="timer-card-icon">🧘</div></div>
            <div class="timer-card-title" style="margin-bottom:8px">Mindfulness Meditation</div>
            <div class="breath-circle"><div class="breath-circle-inner"><div class="breath-text" id="breath-text" style="color:var(--secondary)">Breathe In</div><div class="breath-sub" id="breath-sub">Through nose</div><div class="breath-count" id="breath-count">4</div></div></div>
            <div class="timer-display"><div class="time" id="mind-display" style="font-size:40px">05:00</div><div class="phase" id="mind-label">5 min · 4-4-4-4 box breathing</div></div>
            <div class="timer-controls" style="justify-content:center"><button class="btn btn-primary" id="mind-start-btn" onclick="toggleMindfulness()">🧘 Begin</button><button class="btn btn-secondary" onclick="resetMindfulness()">↺ Reset</button></div>
            <div class="stats-row" style="justify-content:center"><span class="mini-stat" id="mind-cycles">Cycles: 0</span><span class="mini-stat" id="mind-total">Today: 0 min</span></div>
            <div style="margin-top:14px;padding:14px;background:rgba(0,206,201,0.06);border-radius:10px;font-size:12px;color:var(--text-muted);line-height:1.8;text-align:left">
              <b style="color:var(--secondary)">How to use:</b><br>
              1. Sit quietly and <b>close your eyes</b><br>
              2. Pay attention to your <b>natural breathing</b><br>
              3. Inhale <b>4s</b> → Hold <b>4s</b> → Exhale <b>4s</b> → Hold <b>4s</b><br>
              4. Gently bring your mind back when <b>thoughts wander</b>
            </div>
          </div>
        </div>
      </div>
      
      <!-- BRAIN SWEEP VIEW -->
      <div class="technique-view" id="view-taskdump" style="display:none">
        <div class="timers-grid">
          <div class="timer-card task-dump" id="timer-taskdump">
            <div class="timer-card-header"><div class="timer-card-icon">📝</div><div><div class="timer-card-title">Brain Sweep</div><div class="timer-card-sub">Dump all distractions here</div></div></div>
            <div style="font-size:12px;color:var(--text-muted);line-height:1.8;margin-bottom:12px;padding:12px;background:rgba(255,255,255,0.02);border-radius:10px">
              <b style="color:var(--gold)">How to use:</b> Keep this notepad next to you. Write down every random thought immediately. Don't act on them — just <b>acknowledge and return</b> to your main task worry-free.
            </div>
            <textarea id="task-dump-input" placeholder="What's on your mind? Write down random thoughts, to-dos, ideas, worries..."></textarea>
            <div style="display:flex;gap:8px;margin-top:10px"><button class="btn btn-primary btn-sm" onclick="addDumpTask()" style="flex:1">➕ Add Thought</button><button class="btn btn-secondary btn-sm" onclick="clearDump()">🗑 Clear All</button></div>
            <div class="task-entries" id="task-entries"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

